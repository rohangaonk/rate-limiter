# App
PORT=3000
NODE_ENV=development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Rules provider mode: 'local' (default) or 'aws'
# local → reads RATE_LIMIT_RULES env var at startup
# aws   → polls AppConfig sidecar at localhost:2772 every 15s
APP_MODE=local

# Rate Limit Rules (JSON array) — used when APP_MODE=local
# Each rule: { "prefix": "ip"|"user"|"apikey", "capacity": N, "refillRate": N }
RATE_LIMIT_RULES=[{"prefix":"ip","capacity":10,"refillRate":2},{"prefix":"user","capacity":50,"refillRate":10},{"prefix":"apikey","capacity":100,"refillRate":20}]

# AppConfig sidecar config — used when APP_MODE=aws
APPCONFIG_APP=rate-limiter
APPCONFIG_ENV=production
APPCONFIG_PROFILE=rules
